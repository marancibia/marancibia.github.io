          "interpreter" : "script.medium",
          "taskStatus" : "SUCCESS",
          "status" : "SUCCESS",
          "results" : [
            {
              "message" : "\nFunction FIND_HOTEL_ALTERNATIVES compiled\n\n\n---------------------------\n\nFunction FIND_CAR_ALTERNATIVES compiled\n\n\n---------------------------\n",
              "type" : "TEXT"
            }
          ],
