        "hasTitle" : true,
        "message" : [
          "%script",
          "",
          "DECLARE",
          "  v_response VARCHAR2(4000);",
          "BEGIN",
          "  v_response :=  DBMS_CLOUD_AI_AGENT.RUN_TEAM(",
